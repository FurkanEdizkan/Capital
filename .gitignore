# Repo-wide ignores. Per-app ignores live in engine/.gitignore and web/.gitignore.

# Local environment / secrets — never commit
.env
.env.local
*.local

# PostgreSQL data volume + backups (see Deployment plan)
data/

# Node (root tooling — husky/commitlint)
node_modules/

# Python
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
*.log

# Claude Code: ignore local session state by default, but keep the
# project-committed settings.json — it registers the My-Skills marketplace and
# enables the skills plugin for anyone working in this repo (see AGENTS.md).
.claude/*
!.claude/settings.json
# Team-shared skills are vendored under .claude/skills/ and committed so every
# contributor gets them on clone (no plugin install needed). Only the folders
# listed below + skills-lock.json are tracked; all other .claude/ content —
# local settings, locally-installed skills, worktrees — stays ignored. Versions
# are managed by scripts/skills-sync.mjs (see .claude/skills/README.md); add a
# new "!.claude/skills/<name>/" line plus a lock entry to share more.
!.claude/skills/
.claude/skills/*
!.claude/skills/skills-lock.json
!.claude/skills/README.md
!.claude/skills/conventional-commits/
!.claude/skills/conventional-branches/
!.claude/skills/design-taste-frontend/
